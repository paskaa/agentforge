# .env file
# Copy to .env and fill in your actual values
# Never commit .env to version control!

# === Redis ===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# === Feishu (Lark) ===
FEISHU_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxx
FEISHU_CREDENTIALS_FILE=./config/feishu_credentials.json

# === LLM Provider (Bailian / Dashscope) ===
BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_DEFAULT_MODEL=qwen-plus

# === Model Routing (optional, task-type specific models) ===
MODEL_CODING=qwen-coder-plus
MODEL_ANALYSIS=qwen-plus
MODEL_SIMPLE=qwen-turbo

# === Paths ===
AGENTFORGE_BASE_DIR=./config
SCRIPTS_DIR=./scripts
SKILLS_DIR=./skills
AGENTS_CONFIG_DIR=./config/agents
