[Unit]
Description=AgentForge Executor - %i
After=redis.service

[Service]
Type=simple
WorkingDirectory=/opt/agentforge
ExecStart=/opt/agentforge/venv/bin/python3 -m agentforge executor --agent=%i
Restart=always
RestartSec=5
EnvironmentFile=/opt/agentforge/.env
Environment="PYTHONUNBUFFERED=1"
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agentforge-%i

[Install]
WantedBy=multi-user.target
